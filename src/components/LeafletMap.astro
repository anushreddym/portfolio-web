---
const {
  center = [37.6584, -121.8770], // [lat, lng] San Francisco
  zoom = 12,
  class: className = "",
} = Astro.props;

const id = `leaflet-${Math.random().toString(36).slice(2)}`;
---

<div class={`leaflet_wrap ${className}`}>
  <div
    id={id}
    class="leaflet"
    data-center-lat={center[0]}
    data-center-lng={center[1]}
    data-zoom={zoom}
  ></div>
  <div class="leaflet_time"></div>
</div>

<style>
  .leaflet_wrap {
    position: relative;
    width: 100%;
    height: 12rem;
    border-radius: 14px;
    overflow: hidden;
    background: #000000;
  }

  .leaflet_wrap::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 42%;
    pointer-events: none;
    z-index: 500;
    background: linear-gradient(
      to bottom,
      rgba(10, 10, 10, 0) 0%,
      rgba(10, 10, 10, 0.9) 72%,
      rgba(10, 10, 10, 1) 100%
    );
  }

  .leaflet {
    position: absolute;
    inset: 0;
  }

  .leaflet-container {
    background: #000000 !important;
    border-radius: inherit;
    image-rendering: pixelated;
  }

  .leaflet-pane,
  .leaflet-tile-pane {
    border-radius: inherit;
    overflow: hidden;
  }

  .leaflet-tile {
    background-color: #000000;
    image-rendering: pixelated;
  }

  .leaflet-control-attribution {
    display: none !important;
  }

  .leaflet_time {
    position: absolute;
    right: 10px;
    top: 10px;
    z-index: 600;
    padding: 0.3rem 0.45rem;
    border-radius: 6px;
    background: rgba(0, 0, 0, 0.7);
    color: rgba(230, 237, 243, 0.64);
    font-size: 0.85rem;
    font-weight: 500;
    letter-spacing: 0.03em;
  }
</style>

<link
  rel="stylesheet"
  href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
/>

<script define:vars={{ id }}>
  const el = document.getElementById(id);
  const timeEl = el?.parentElement?.querySelector(".leaflet_time");

  const loadLeaflet = () =>
    new Promise((resolve, reject) => {
      if (window.L) return resolve(window.L);

      const existing = document.querySelector('script[data-leaflet="1"]');
      if (existing) {
        existing.addEventListener("load", () => resolve(window.L));
        existing.addEventListener("error", reject);
        return;
      }

      const script = document.createElement("script");
      script.src = "https://unpkg.com/leaflet@1.9.4/dist/leaflet.js";
      script.async = true;
      script.dataset.leaflet = "1";
      script.onload = () => resolve(window.L);
      script.onerror = reject;
      document.head.appendChild(script);
    });

  if (!el) {
    console.warn("[LeafletMap] mount element not found");
  } else {
    loadLeaflet()
      .then((L) => {
        const lat = Number(el.dataset.centerLat);
        const lng = Number(el.dataset.centerLng);
        const zoom = Number(el.dataset.zoom);

        const map = L.map(el, {
          center: [lat, lng],
          zoom,
          zoomControl: false,
          attributionControl: false,
          dragging: false,
          scrollWheelZoom: false,
          doubleClickZoom: false,
          boxZoom: false,
          keyboard: false,
          tap: false,
          touchZoom: false,
        });

        L.tileLayer("https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png", {
          maxZoom: 15,
          subdomains: "abcd",
          attribution: "",
        }).addTo(map);

        L.circleMarker([lat, lng], {
          radius: 6,
          color: "#58a6ff",
          weight: 2,
          fillColor: "#58a6ff",
          fillOpacity: 0.25,
        }).addTo(map);

        requestAnimationFrame(() => {
          map.invalidateSize();
        });
      })
      .catch((err) => {
        console.error("[LeafletMap] failed to load Leaflet", err);
      });

    if (timeEl) {
      const fmt = new Intl.DateTimeFormat([], {
        hour: "2-digit",
        minute: "2-digit",
      });
      const update = () => {
        timeEl.textContent = `${fmt.format(new Date())} PST`;
      };
      update();
      setInterval(update, 30000);
    }
  }
</script>

