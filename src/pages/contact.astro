---
import "../styles/contact.css"
import logoImage from "../assets/logo.png"
import LeafletMap from "../components/LeafletMap.astro"
import Navbar from "../components/Navbar.astro"
import Footer from "../components/Footer.astro"
import Background from "../components/Background.astro"
---
<html lang="en">
   <head>
      <meta charset="UTF-8" />
      <meta name="viewport" content="width=device-width, initial-scale=1.0" />
      <link rel="preconnect" href="https://fonts.googleapis.com">
      <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
      <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700;800&display=swap" rel="stylesheet">
      <link rel="icon" href={logoImage.src} />
      <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
      <title>Anush - Contact</title>
   </head>
   <body>
      <div class="holder">
         <Navbar />
         <div class="gradient_holder"></div>
         <main class="contact">
            <section class="contact_inner">
               <div class="contact_email_section">
                  <div class="contact_email_title_holder">
                     <h1 class="contact_email_title">Email</h1>
                  </div>
                  <p class="contact_email_text">
                     Send me an email or fill out the form below to get in touch! I'll try to respond as soon as possible.
                  </p>
                  <p class="contact_email_line">
                     My email is: <a class="contact_email_link" href="mailto:anumuga09@gmail.com">anumuga09@gmail.com</a>
                  </p>
               </div>
               <div class="contact_divider"></div>
               <div class="form_title_holder">
                  <h1 class="form_title">Form</h1>
               </div>
               <form class="contact_form">
                  <div class="form_field">
                     <label class="form_label" for="name">Name</label>
                     <input class="form_input" type="text" id="name" name="name" placeholder="Your name" required />
                  </div>
                  <div class="form_field">
                     <label class="form_label" for="email">Email</label>
                     <input class="form_input" type="email" id="email" name="email" placeholder="you@example.com" required />
                  </div>
                  <div class="form_field">
                     <label class="form_label" for="message">Message</label>
                     <textarea class="form_input form_textarea" id="message" name="message" placeholder="What's up?" rows="5" required></textarea>
                  </div>
                  <button class="form_submit_btn" type="submit">
                  <span class="form_submit_label">Send message</span>
                  <i class="fa-solid fa-paper-plane"></i>
                  </button>
               </form>
            </section>
         </main>
      </div>
      <Footer />
   </body>
</html>