---
import "../styles/gallery.css"
import logoImage from "../assets/logo.png"
import placeholderImage from "../assets/placeholder.png"
import Navbar from "../components/Navbar.astro"
import Footer from "../components/Footer.astro"
import Background from "../components/Background.astro"
import bridge from "../assets/bridge.jpeg"
import capitol from "../assets/capitol.jpeg"
import eiffel from "../assets/eiffel.jpeg"
import falls from "../assets/falls.jpg"
import lights from "../assets/lights.jpeg"
import nyc_night from "../assets/nyc_night.jpeg"
import nyc from "../assets/nyc.jpeg"
import rainbow from "../assets/rainbow.jpeg"
import square from "../assets/square.jpeg"
import statue from "../assets/statue.jpeg"
import switzerland from "../assets/switzerland.jpeg"
import zurich from "../assets/zurich.jpeg"

const photos = [
  {
    image: bridge,
    location: "Rainbow Bridge, Ontario",
  },
  {
    image: capitol,
    location: "Capitol Hill, Washington D.C.",
  },
  {
    image: eiffel,
    location: "Eiffel Tower, Paris",
  },
  {
    image: falls,
    location: "Rhine Falls, Switzerland",
  },
  {
    image: lights,
    location: "Robbinsville, New Jersey",
  },
  {
    image: nyc_night,
    location: "New York City, NY",
  },
  {
    image: nyc,
    location: "New York City, NY",
  },
  {
    image: rainbow,
    location: "Power Station, Niagara Falls, Ontario",
  },
   {
      image: square,
      location: "Times Square, New York City, NY",
   },
   {
      image: statue,
      location: "Statue of Liberty, New York City, NY",
   },
   {
      image: switzerland,
      location: "Jungfraujoch, Switzerland",
   },
   {
      image: zurich,
      location: "Lake Zurich, Switzerland",
   },
]
---
<html lang="en">
   <head>
      <meta charset="UTF-8" />
      <meta name="viewport" content="width=device-width, initial-scale=1.0" />
      <link rel="preconnect" href="https://fonts.googleapis.com">
      <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
      <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700;800&display=swap" rel="stylesheet">
      <link rel="icon" href={logoImage.src} />
      <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
      <title>Anush - Gallery</title>
   </head>
   <body>
      <div class="holder">
         <Navbar />
         <div class="gradient_holder"></div>
         <main class="gallery_page">
            <section class="gallery_page_header">
               <div class="gallery_page_title_holder">
                  <h1 class="gallery_page_title">Photos</h1>
               </div>
               <p class="gallery_page_desc">
                  A few photos I've taken that I'm proud of.
               </p>
            </section>
            <div class="gallery_page_grid">
               {photos.map((photo) => (
                  <figure class="photo_card">
                     <div class="photo_card_image">
                        <img src={photo.image.src} alt={photo.location} />
                     </div>
                     <figcaption class="photo_card_caption">
                        <i class="fa-solid fa-location-dot"></i>
                        <span>{photo.location}</span>
                     </figcaption>
                  </figure>
               ))}
            </div>
         </main>
      </div>
      <Footer />
   </body>
</html>