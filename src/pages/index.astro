---
import "../styles/home.css"
import logoImage from "../assets/logo.png"
import orreryImage from "../assets/orrery.png"
import placeholderImage from "../assets/placeholder.png"
import LeafletMap from "../components/LeafletMap.astro"
import Navbar from "../components/Navbar.astro"
import Footer from "../components/Footer.astro"
import Background from "../components/Background.astro"
---
<html lang="en">
   <head>
      <meta charset="UTF-8" />
      <meta name="viewport" content="width=device-width, initial-scale=1.0" />
      <link rel="preconnect" href="https://fonts.googleapis.com">
      <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
      <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700;800&display=swap" rel="stylesheet">
      <link rel="icon" href={logoImage.src} />
      <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
      <title>Anush - Portfolio</title>
   </head>
   <body>
      <div class="holder">
         <Navbar />
         <div class="gradient_holder"></div>
         <main class="home">
            <section class="home_inner">
               <LeafletMap />
               <h1 class="hero_title">Hey, I’m Anush 👋</h1>
               <p class="hero_description">
                  Foothill High School Class of 2027. I like playing the piano and making things that sometimes work. 
               </p>
               <a class="resume_btn" href="/resume.pdf" target="_blank" rel="noopener noreferrer">
               <i class="fa-solid fa-file-arrow-down"></i>
               <span class="resume_btn_label">Resume</span>
               </a>
               <div class="landing_links">
                  <a class="landing_btn" href="/projects">
                  <span class="landing_btn_label">Projects</span>
                  <span class="landing_btn_sub">Things I’ve made</span>
                  </a>
                  <a class="landing_btn" href="/blog">
                  <span class="landing_btn_label">About</span>
                  <span class="landing_btn_sub">Learn about me</span>
                  </a>
                  <a class="landing_btn" href="/contact">
                  <span class="landing_btn_label">Contact</span>
                  <span class="landing_btn_sub">Get in touch</span>
                  </a>
               </div>
            </section>
         </main>
         
<section class="exp_section">
   <input type="radio" name="exp_tabs" id="exp-work" class="exp_tab_input" checked />
   <input type="radio" name="exp_tabs" id="exp-education" class="exp_tab_input" />

   <div class="exp_tabs_switch">
      <label class="exp_tab_btn" for="exp-work">Work</label>
      <label class="exp_tab_btn" for="exp-education">Education</label>
   </div>

   <div class="exp_panel" id="exp-panel-work">
      <div class="exp_empty">
         <span class="exp_empty_icon">
            <i class="fa-solid fa-briefcase"></i>
         </span>
         <p class="exp_empty_title">Nothing here yet</p>
         <p class="exp_empty_desc">Someone please give me a job 🙏🙏</p>
      </div>
   </div>

   <div class="exp_panel" id="exp-panel-education">
      <div class="exp_entry">
         <div class="exp_entry_marker">
            <span class="exp_entry_logo">FHS</span>
            <span class="exp_entry_line"></span>
         </div>
         <div class="exp_entry_body">
            <div class="exp_entry_head">
               <div>
                  <h3 class="exp_entry_title">Foothill High School</h3>
                  <p class="exp_entry_subtitle">High School Diploma</p>
               </div>
               <span class="exp_entry_date">Aug 2023 - Jun 2027</span>
            </div>
            <ul class="exp_entry_bullets">
               <li>Graduating next year!</li>
            </ul>
         </div>
      </div>

      <div class="exp_entry">
         <div class="exp_entry_marker">
            <span class="exp_entry_logo">CO</span>
         </div>
         <div class="exp_entry_body">
            <div class="exp_entry_head">
               <div>
                  <h3 class="exp_entry_title">College</h3>
                  <p class="exp_entry_subtitle">Bachelor's Degree</p>
               </div>
               <span class="exp_entry_date">August 2027 - May 2031</span>
            </div>
            <ul class="exp_entry_bullets">
               <li>I haven't commited to a university yet.</li>
            </ul>
         </div>
      </div>
   </div>
</section>
<div class="skills_section">
   <div class="skills_title_holder">
      <h1 class="skills_title">Skills</h1>
   </div>

   <div class="skills_switcher">
      <div class="skills_scroll_track" id="skills-scroll-track">
         <div class="skills_panel" id="skills-panel-0">
            <h3 class="skills_panel_title">Languages</h3>
            <div class="skill_pill_holder">
               <span class="skill_pill">Java</span>
               <span class="skill_pill">Python</span>
               <span class="skill_pill">C++</span>
               <span class="skill_pill">C#</span>
               <span class="skill_pill">JavaScript</span>
               <span class="skill_pill">TypeScript</span>
               <span class="skill_pill">HTML</span>
               <span class="skill_pill">CSS</span>
               <span class="skill_pill">Lua</span>
            </div>
         </div>
         <div class="skills_panel" id="skills-panel-1">
            <h3 class="skills_panel_title">Frameworks & Tools</h3>
            <div class="skill_pill_holder">
               <span class="skill_pill">React</span>
               <span class="skill_pill">Astro</span>
               <span class="skill_pill">Tailwind</span>
               <span class="skill_pill">Node.js</span>
               <span class="skill_pill">Supabase</span>
               <span class="skill_pill">Google Firebase</span>
               <span class="skill_pill">Git</span>
               <span class="skill_pill">WSL</span>
               <span class="skill_pill">Cloudflare</span>
            </div>
         </div>
         <div class="skills_panel" id="skills-panel-2">
            <h3 class="skills_panel_title">Hardware</h3>
            <div class="skill_pill_holder">
               <span class="skill_pill">Custom PCB Design</span>
               <span class="skill_pill">Kicad</span>
               <span class="skill_pill">Raspberry Pi</span>
               <span class="skill_pill">3D Printer Hardware</span>
               <span class="skill_pill">Microcontrollers</span>
            </div>
         </div>
         <div class="skills_panel" id="skills-panel-3">
            <h3 class="skills_panel_title">Design Software</h3>
            <div class="skill_pill_holder">
               <span class="skill_pill">Kicad</span>
               <span class="skill_pill">Fusion 360</span>
               <span class="skill_pill">Inventor</span>
            </div>
         </div>
      </div>

      <div class="skills_progress_rail" id="skills-progress-rail">
         <button type="button" class="skills_progress_dash active" data-target="skills-panel-0" aria-label="Languages">
            <span class="skills_progress_dash_bar"></span>
         </button>
         <button type="button" class="skills_progress_dash" data-target="skills-panel-1" aria-label="Frameworks & Tools">
            <span class="skills_progress_dash_bar"></span>
         </button>
         <button type="button" class="skills_progress_dash" data-target="skills-panel-2" aria-label="Hardware">
            <span class="skills_progress_dash_bar"></span>
         </button>
         <button type="button" class="skills_progress_dash" data-target="skills-panel-3" aria-label="Design Software">
            <span class="skills_progress_dash_bar"></span>
         </button>
      </div>
   </div>
</div>

         <div class="projects_section">
            <div class="projects_title_holder">
               <h1 class="projects_title">Latest projects</h1>
            </div>
            <div class="project_tile_holder">
               <a class="project_tile" href="/projects/project-one">
                  <div class="project_tile_image">
                     <img src={placeholderImage.src} alt="Project One preview" />
                  </div>
                  <div class="project_tile_content">
                     <h3 class="project_tile_title">Project One</h3>
                     <p class="project_tile_desc">
                        Lorem ipsum dolor sit amet, consectetur adipiscing elit. A short description of what this project does and why it matters.
                     </p>
                     <div class="project_tile_tech">
                        <span class="tech_pill">React</span>
                        <span class="tech_pill">Node.js</span>
                        <span class="tech_pill">PostgreSQL</span>
                     </div>
                  </div>
               </a>
               <a class="project_tile" href="/projects/project-two">
                  <div class="project_tile_image">
                     <img src={placeholderImage.src} alt="Project Two preview" />
                  </div>
                  <div class="project_tile_content">
                     <h3 class="project_tile_title">Project Two</h3>
                     <p class="project_tile_desc">
                        Lorem ipsum dolor sit amet, consectetur adipiscing elit. A short description of what this project does and why it matters.
                     </p>
                     <div class="project_tile_tech">
                        <span class="tech_pill">Astro</span>
                        <span class="tech_pill">TypeScript</span>
                        <span class="tech_pill">Leaflet</span>
                     </div>
                  </div>
               </a>
            </div>
         </div>
      </div>
      <Footer />
   </body>
</html>

<script>
  const track = document.getElementById("skills-scroll-track");
  const dashes = Array.from(
    document.querySelectorAll<HTMLButtonElement>(".skills_progress_dash")
  );
  const panels = Array.from(
    document.querySelectorAll<HTMLDivElement>(".skills_panel")
  );
 
  const setActive = (index: number) => {
    dashes.forEach((dash, i) => dash.classList.toggle("active", i === index));
  };
 
  dashes.forEach((dash) => {
    dash.addEventListener("click", () => {
      const targetId = dash.dataset.target;
      if (!targetId) return;
 
      const target = document.getElementById(targetId);
      if (!target) return;
 
      target.scrollIntoView({ behavior: "smooth", block: "nearest", inline: "nearest" });
    });
  });
 
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const index = panels.indexOf(entry.target as HTMLDivElement);
          setActive(index);
        }
      });
    },
    { root: track, threshold: 0.6 }
  );
 
  panels.forEach((panel) => observer.observe(panel));
</script>