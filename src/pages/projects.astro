---
import "../styles/projects.css"
import logoImage from "../assets/logo.png"
import placeholderImage from "../assets/placeholder.png"
import orreryImage from "../assets/orrery.png"
import Navbar from "../components/Navbar.astro"
import Footer from "../components/Footer.astro"
import shiftAtMidnightImage from "../assets/shift_mod.png"
import svgConverterImage from "../assets/converter-pic.png"
import flowImage from "../assets/flowimage.png"
import portfolioImage from "../assets/portfolio.png"
import atlasImage from "../assets/atlas.png"
import Background from "../components/Background.astro"

const projects = [
   {
      slug: "project-one",
      title: "2d Orbit Simulation",
      desc: "Made in a week. Physics based 2d orbit simulation made in Godot engine.",
      tech: ["Godot", "Gdscript", "Physics"],
      image: orreryImage,
      year: "2025",
      docsUrl: null,
      demoUrl: "https://curiosityxd.itch.io/2d-orerry",
      codeUrl: "https://github.com/anushreddym/Godot-2D-Orrery-Model",
   },
   {
      slug: "project-two",
      title: "SVG G-code Convertor",
      desc: "A simple site that converts SVG files to G-code for CNC machines. Made in a week.",
      tech: ["JavaScript", "SVG", "G-code"],
      image: svgConverterImage,
      year: "2026",
      docsUrl: null,
      demoUrl: "https://anushreddym.github.io/svg-gcode-convertor/",
      codeUrl: "https://github.com/anushreddym/svg-gcode-convertor",
   },
   {
      slug: "project-three",
      title: "Lobby Expansion Mod",
      desc: "A mod for Shift at Midnight that increases the maximum lobby player count.",
      tech: ["C#", "BepInEx", "Harmony Patches"],
      image: shiftAtMidnightImage,
      year: "2026",
      docsUrl: null,
      demoUrl: "https://thunderstore.io/c/shift-at-midnight/p/Decahedron_Studios/MoreShiftAtMidnightPlayers/",
      codeUrl: "https://github.com/anushreddym/MoreShiftAtMidnightPlayers",
   },
   {
      slug: "project-four",
      title: "Java Flow Puzzle",
      desc: "A logic puzzle game built for my APCSA final project. Built in 2 months using Java.",
      tech: ["Java", "Swing", "AWT"],
      image: flowImage,
      year: "2024",
      docsUrl: null,
      demoUrl: "https://github.com/anushreddym/flow-puzzle/releases/tag/java",
      codeUrl: "https://github.com/anushreddym/flow-puzzle",
   },
   {
      slug: "project-five",
      title: "Portfolio",
      desc: "This website! Built using Astro and hosted on Firebase with Discord webhook integration.",
      tech: ["Astro", "Firebase", "Webhook API"],
      image: portfolioImage,
      year: "2026",
      docsUrl: null,
      demoUrl: "https://anushmudiganti.xyz",
      codeUrl: "https://github.com/anushreddym/portfolio-web",
   },
   {
      slug: "project-six",
      title: "Atlas",
      desc: "Built for NASA Space Apps 2025 in 2 days. Hosted on Firebase with Google Maps integration.",
      tech: ["Astro", "Mapbox GL JS", "NASA POWER"],
      image: atlasImage,
      year: 2025,
      docsUrl: null,
      demoUrl: "https://atlas--atlas-spaceapps.us-central1.hosted.app/",
      codeUrl: "https://github.com/anushreddym/atlas-spaceapps",
   }
]
---

<html lang="en">
   <head>
      <meta charset="UTF-8" />
      <meta name="viewport" content="width=device-width, initial-scale=1.0" />
      <link rel="preconnect" href="https://fonts.googleapis.com" />
      <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
      <link
         href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700;800&display=swap"
         rel="stylesheet"
      />
      <link rel="icon" href={logoImage.src} />
      <link
         rel="stylesheet"
         href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
      />
      <title>Anush - Projects</title>
   </head>

   <body>
      <div class="holder">
         <Navbar />

         <div class="gradient_holder"></div>

         <main class="projects_page">
            <section class="projects_page_header">
               <div class="projects_page_title_holder">
                  <h1 class="projects_page_title">Projects</h1>
               </div>

               <p class="projects_page_desc">
                  Here are some the things I've made over the last few years.
                  Click on any of them to view a full write up/demo of the
                  project.
               </p>
            </section>

            <div class="projects_page_grid">
               {projects.map((project) => (
                  <div class="project_card">
                     <a
                        class="project_card_stretched"
                        href={project.demoUrl}
                        aria-label={`View demo of ${project.title}`}
                        target="_blank"
                        rel="noopener noreferrer"
                     ></a>

                     <div class="project_card_image">
                        <img
                           src={project.image.src}
                           alt={`${project.title} preview`}
                        />

                        {project.year && (
                           <span class="project_card_year">
                              {project.year}
                           </span>
                        )}
                     </div>

                     <div class="project_card_content">
                        <h3 class="project_card_title">{project.title}</h3>

                        <p class="project_card_desc">{project.desc}</p>

                        <div class="project_card_tech">
                           {project.tech.map((tech) => (
                              <span class="tech_pill">{tech}</span>
                           ))}
                        </div>

                        <div class="project_card_actions">
                           {project.docsUrl && (
                              <a
                                 class="project_card_action"
                                 href={project.docsUrl}
                                 target="_blank"
                                 rel="noopener noreferrer"
                              >
                                 <i class="fa-solid fa-book"></i>
                                 <span>Docs</span>
                              </a>
                           )}

                           {project.codeUrl && (
                              <a
                                 class="project_card_action"
                                 href={project.codeUrl}
                                 target="_blank"
                                 rel="noopener noreferrer"
                              >
                                 <i class="fa-brands fa-github"></i>
                                 <span>Source</span>
                              </a>
                           )}

                           {project.demoUrl && (
                              <a
                                 class="project_card_action project_card_action_primary"
                                 href={project.demoUrl}
                                 target="_blank"
                                 rel="noopener noreferrer"
                              >
                                 <i class="fa-solid fa-arrow-up-right-from-square"></i>
                                 <span>Demo</span>
                              </a>
                           )}
                        </div>
                     </div>
                  </div>
               ))}
            </div>
         </main>
      </div>

      <Footer />
   </body>
</html>