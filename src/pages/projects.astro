---
import "../styles/projects.css"
import logoImage from "../assets/logo.png"
import placeholderImage from "../assets/placeholder.png"
import orreryImage from "../assets/orrery.png"
import Navbar from "../components/Navbar.astro"
import Footer from "../components/Footer.astro"
import Background from "../components/Background.astro"

const projects = [
  {
    slug: "project-one",
    title: "2d Orbit Simulation",
    desc: "Made in a week. Physics based 2d orbit simulation made in Godot engine.",
    tech: ["Godot", "Gdscript", "Physics"],
    image: orreryImage,
    year: "2025",
    docsUrl: null,
    demoUrl: "https://curiosityxd.itch.io/2d-orerry",
  },
  {
    slug: "project-two",
    title: "Project Two",
    desc: "Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor.",
    tech: ["Astro", "TypeScript", "Leaflet"],
    image: placeholderImage,
    year: "2025",
    docsUrl: "#",
    demoUrl: "#",
  },
  {
    slug: "project-three",
    title: "Project Three",
    desc: "Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor.",
    tech: ["Python", "OpenCV", "Raspberry Pi"],
    image: placeholderImage,
    year: "2024",
    docsUrl: null,
    demoUrl: "#",
  },
  {
    slug: "project-four",
    title: "Project Four",
    desc: "Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor.",
    tech: ["KiCad", "C++", "Microcontrollers"],
    image: placeholderImage,
    year: "2024",
    docsUrl: null,
    demoUrl: "#",
  },
]
---
<html lang="en">
   <head>
      <meta charset="UTF-8" />
      <meta name="viewport" content="width=device-width, initial-scale=1.0" />
      <link rel="preconnect" href="https://fonts.googleapis.com">
      <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
      <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700;800&display=swap" rel="stylesheet">
      <link rel="icon" href={logoImage.src} />
      <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
      <title>Anush - Projects</title>
   </head>
   <body>
      <div class="holder">
         <Navbar />
         <div class="gradient_holder"></div>
         <main class="projects_page">
            <section class="projects_page_header">
               <div class="projects_page_title_holder">
                  <h1 class="projects_page_title">Projects</h1>
               </div>
               <p class="projects_page_desc">
                  Here are some the things I've made over the last few years. Click on any of them to view a full write up/demo of the project.
               </p>
            </section>
            <div class="projects_page_grid">
               {projects.map((project) => (
                  <div class="project_card">
                     <a
                        class="project_card_stretched"
                        href={project.demoUrl}
                        aria-label={`View demo of ${project.title}`}
                     ></a>
                     <div class="project_card_image">
                        <img src={project.image.src} alt={`${project.title} preview`} />
                        {project.year && (
                           <span class="project_card_year">{project.year}</span>
                        )}
                     </div>
                     <div class="project_card_content">
                        <h3 class="project_card_title">{project.title}</h3>
                        <p class="project_card_desc">{project.desc}</p>
                        <div class="project_card_tech">
                           {project.tech.map((tech) => (
                              <span class="tech_pill">{tech}</span>
                           ))}
                        </div>
                        <div class="project_card_actions">
                           {project.docsUrl && (
                              <a
                                 class="project_card_action"
                                 href={project.docsUrl}
                                 target="_blank"
                                 rel="noopener noreferrer"
                              >
                                 <i class="fa-solid fa-book"></i>
                                 <span>Docs</span>
                              </a>
                           )}
                           <a
                              class="project_card_action project_card_action_primary"
                              href={project.demoUrl}
                              target="_blank"
                              rel="noopener noreferrer"
                           >
                              <i class="fa-solid fa-arrow-up-right-from-square"></i>
                              <span>Demo</span>
                           </a>
                        </div>
                     </div>
                  </div>
               ))}
            </div>
         </main>
      </div>
      <Footer />
   </body>
</html>